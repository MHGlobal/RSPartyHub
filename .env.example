# RS Party Hub — configuração (copiar para .env se necessário)
# Todas as variáveis são opcionais; defaults funcionam out-of-the-box.

# Porta HTTP/WebSocket do anfitrião (default 3210)
RS_PARTY_PORT=3210

# Interface de bind (default 0.0.0.0 — necessário para LAN; nunca 127.0.0.1 em modo festa)
RS_PARTY_BIND=0.0.0.0

# Diretório de dados runtime (DB SQLite, library/, uploads/, logs/)
RS_PARTY_HOME=./.rs-party-home

# Caminho alternativo direto para a base de dados
# RS_PARTY_DB=./.rs-party-home/data/rsparty.sqlite

# Token de administração (se definido, /api/admin/overview exige header x-admin-token)
# RS_PARTY_ADMIN_TOKEN=troca-isto

# Máximo de jogadores por sala (default 12)
RS_PARTY_MAX_PLAYERS=12

# Duração do ecrã de resultados antes do próximo jogo do Party Mix (ms)
RS_PARTY_RESULTS_MS=8000

# Graça de desconexão antes de marcar jogador como offline (ms)
RS_PARTY_DISCONNECT_GRACE_MS=60000

# Multiplicador de rate limits — APENAS para testes/carga (default 1)
# RS_PARTY_RATE_MULT=1
